# pnpm 配置文件

# 严格对等依赖
strict-peer-dependencies=false

# 自动安装对等依赖
auto-install-peers=true

# shamefully-hoist 选项（用于兼容性）
# 注意：在新版 pnpm 中，建议使用 hoist-pattern
shamefully-hoist=true

# 锁文件格式
lockfile-format=v6

# 保存时使用精确版本
save-exact=false

# 忽略开发依赖的更新
prefer-workspace-packages=true

# 使用 npm 镜像源（可选，根据需要配置）
# registry=https://registry.npmmirror.com
